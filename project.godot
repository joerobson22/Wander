; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wander"
config/description="Walk your animals through beautiful scenery while you work."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Mobile")
run/low_processor_mode=true
boot_splash/bg_color=Color(0.37254903, 0.56078434, 0.3529412, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/brand/splash.png"
config/icon="res://assets/brand/app_icon.svg"

[autoload]

Content="*res://core/content.gd"
App="*res://core/app.gd"
Outdoors="*res://core/outdoors.gd"
Audio="*res://core/audio.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=5

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.960784, 0.952941, 0.933333, 1)
